# NetplaySourceIdentity.cmake -- a platform-independent netplay build identity.
#
# The engine's default netplay build fingerprint is FNV-1a over the running
# executable's bytes (runner/runtime_evidence.c). That is exact, but a macOS
# binary and a Windows binary of the SAME source can never share it, so the
# lobby (exact game_version match) would keep them apart.
#
# This script fingerprints what the two binaries are built FROM instead: every
# source file that can be compiled into the runner (game adapter, generated
# 68K->C, engine runner, m68k-recomp-core, recompiler sources the runner
# shares, recomp-net, rbengine, recomp-ui), the CMake files that decide what
# is compiled, plus the build options that change the code. Any edit to any of those -- including regenerated C from a
# different game.toml or ROM -- gives a different identity; two builds of one
# source tree on different OSes/compilers give the same identity.
# CR bytes are dropped before hashing so a CRLF checkout matches an LF one.
#
# Script mode:
#   cmake -DOUT=<header> -DBASE=<game repo> -DROOTS=<dir|dir|...> -DGEN_DIR=<generated dir>
#         [-DBUILD_DIR=<binary dir>] -DOPTIONS=<k=v|k=v>
#         -P NetplaySourceIdentity.cmake
#
# Writes <header> (only when its content changes) defining
#   GENESIS_NETPLAY_SOURCE_FP      uint32 (first 8 hex of the SHA-256)
#   GENESIS_NETPLAY_SOURCE_SHA256  the full digest, for logs

foreach(_v OUT BASE ROOTS GEN_DIR)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "NetplaySourceIdentity.cmake: ${_v} is required")
    endif()
endforeach()

# Lists arrive '|'-separated (a ';' does not survive a custom command line).
string(REPLACE "|" ";" ROOTS "${ROOTS}")
if(DEFINED OPTIONS)
    string(REPLACE "|" ";" OPTIONS "${OPTIONS}")
endif()

set(_manifest "netplay-source-identity v1\n")
foreach(_opt IN LISTS OPTIONS)
    string(APPEND _manifest "option ${_opt}\n")
endforeach()

set(_patterns *.c *.cc *.cpp *.cxx *.h *.hh *.hpp *.inc *.inl *.toml *.csv *.txt *.cmake)

foreach(_root IN LISTS ROOTS)
    if(NOT IS_DIRECTORY "${_root}")
        message(FATAL_ERROR "NetplaySourceIdentity: missing source root ${_root}")
    endif()
    file(RELATIVE_PATH _root_name "${BASE}" "${_root}")
    set(_globs "")
    foreach(_p IN LISTS _patterns)
        list(APPEND _globs "${_root}/${_p}")
    endforeach()
    file(GLOB_RECURSE _files LIST_DIRECTORIES false RELATIVE "${_root}" ${_globs})
    list(SORT _files)
    foreach(_f IN LISTS _files)
        # Never part of a build: vendored prebuilt SDL, VCS/build/test trees.
        if(_f MATCHES "(^|/)(\\.git|build[^/]*|tests?|scratch|external/SDL2)/")
            continue()
        endif()
        file(READ "${_root}/${_f}" _c)
        string(REPLACE "\r" "" _c "${_c}")
        string(SHA256 _h "${_c}")
        string(APPEND _manifest "${_root_name}/${_f} ${_h}\n")
    endforeach()
endforeach()

# Single files (e.g. the game's top-level CMakeLists.txt), '|'-separated.
if(DEFINED FILES AND NOT FILES STREQUAL "")
    string(REPLACE "|" ";" FILES "${FILES}")
    foreach(_f IN LISTS FILES)
        file(READ "${_f}" _c)
        string(REPLACE "\r" "" _c "${_c}")
        string(SHA256 _h "${_c}")
        file(RELATIVE_PATH _rel "${BASE}" "${_f}")
        string(APPEND _manifest "${_rel} ${_h}\n")
    endforeach()
endif()

# Generated C is produced on the build host by the same recompiler for every
# target platform. It may name its own output path in a comment, so the build
# and source directories are replaced by fixed tokens before hashing.
file(GLOB _gen LIST_DIRECTORIES false RELATIVE "${GEN_DIR}"
     "${GEN_DIR}/*.c" "${GEN_DIR}/*.h")
list(SORT _gen)
if(NOT _gen)
    message(FATAL_ERROR "NetplaySourceIdentity: no generated sources in ${GEN_DIR}")
endif()
foreach(_f IN LISTS _gen)
    file(READ "${GEN_DIR}/${_f}" _c)
    if(DEFINED BUILD_DIR AND NOT BUILD_DIR STREQUAL "")
        string(REPLACE "${BUILD_DIR}" "<build>" _c "${_c}")
    endif()
    string(REPLACE "${BASE}" "<source>" _c "${_c}")
    string(SHA256 _h "${_c}")
    string(APPEND _manifest "generated/${_f} ${_h}\n")
endforeach()

string(SHA256 _digest "${_manifest}")
string(SUBSTRING "${_digest}" 0 8 _fp)
if(_fp STREQUAL "00000000")
    set(_fp "00000001")   # 0 means "no identity" to recomp-net
endif()

set(_content
"/* Generated by NHL94Recomp cmake/NetplaySourceIdentity.cmake. Do not edit. */
#define GENESIS_NETPLAY_SOURCE_FP 0x${_fp}u
#define GENESIS_NETPLAY_SOURCE_SHA256 \"${_digest}\"
")
get_filename_component(_outdir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_outdir}")
file(WRITE "${OUT}.manifest.txt" "${_manifest}")
set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _content)
    file(WRITE "${OUT}" "${_content}")
endif()
