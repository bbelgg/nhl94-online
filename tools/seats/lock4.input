# Player lock test, 4 seats: NHL94_SEATS=home:C,home:RD,away:C,away:G
# (menu: Head to Head, 30-second periods). PLAYER n = seat n-1 = game pad n.
# All four seats push at once: seat0 UP, seat1 RIGHT, seat2 UP, seat3 LEFT,
# in period 1 (home attacks up) and in period 2 (home attacks down).
WAIT 600
PRESS START 5
WAIT 120
PRESS START 5
WAIT 120
PRESS DOWN 5
WAIT 20
PRESS RIGHT 5
WAIT 20
PRESS RIGHT 5
WAIT 20
PRESS RIGHT 5
WAIT 20
PRESS START 5
WAIT 240
PRESS START 5
WAIT 240
WRITE_RAM16 0xFFD050 0x0003
PRESS START 5
WAIT 420
PLAYER 1
HOLD UP
PLAYER 2
HOLD RIGHT
PLAYER 3
HOLD UP
PLAYER 4
HOLD LEFT
WAIT 120
RELEASE
PLAYER 3
RELEASE
PLAYER 2
RELEASE
PLAYER 1
RELEASE
WAIT_RAM16 0xFFC468 0x0000
WAIT 330
PRESS START 5
WAIT_RAM16 0xFFC2EA 0x0200
WAIT 30
PLAYER 1
HOLD UP
PLAYER 2
HOLD RIGHT
PLAYER 3
HOLD UP
PLAYER 4
HOLD LEFT
WAIT 120
RELEASE
PLAYER 3
RELEASE
PLAYER 2
RELEASE
PLAYER 1
RELEASE
WAIT 300
