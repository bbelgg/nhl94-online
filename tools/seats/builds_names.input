# Builds names check: the demo_penalties setup, then screenshots around the injected penalty
# (run with NHL94_FORMAT=4v4 NHL94_FORMAT_TEST_PENALTY=1900:0:4,2600:1:4; paths are absolute -- edit).
WAIT 600
PRESS START 5
WAIT 120
PRESS START 5
WAIT 120
PRESS DOWN 5
WAIT 20
PRESS RIGHT 5
WAIT 20
PRESS RIGHT 5
WAIT 20
PRESS RIGHT 5
WAIT 20
PRESS RIGHT 5
WAIT 20
PRESS START 5
WAIT 240
PRESS START 5
WAIT 240
WRITE_RAM16 0xFFD056 0x0001
WRITE_RAM16 0xFFD058 0x0000
PRESS START 5
WAIT 1650
WAIT 40
SCREENSHOT /tmp/nhl94-online-build/eashl/out-builds/shot_00.png
WAIT 40
SCREENSHOT /tmp/nhl94-online-build/eashl/out-builds/shot_01.png
